<Project Sdk="Microsoft.NET.Sdk">
  <!-- Copy this folder into the video workspace, outside any repository, so no repository's build settings apply. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- The Playwright driver files exceed MAX_PATH under deep folders on Windows: build into a short path. The hash of
         the project folder keeps the recorders of different workspaces apart. "dotnet build" prints the path:
         "Recorder -> <bin>/Recorder.dll". -->
    <BaseOutputPath>$([System.IO.Path]::Combine($([System.IO.Path]::GetTempPath()), 'aspirevideo', $([MSBuild]::StableStringHash($(MSBuildProjectDirectory)).ToString('x8')), 'bin'))$([System.IO.Path]::DirectorySeparatorChar)</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
  </ItemGroup>
</Project>
