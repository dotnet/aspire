@* The header button of the live view and recordings. It opens the recordings panel, like the notifications and
   settings buttons open theirs. *@
<div class="application-run-select">
    <FluentButton Id="@ButtonId"
                  Class="@($"header-button application-run-select-button{(SelectedRunIsCurrent ? string.Empty : " historical")}")"
                  Appearance="ButtonAppearance.Default"
                  OnClick="@OnClick"
                  data-tooltip="@RunSelectTitle"
                  aria-label="@RunSelectAccessibleLabel"
                  aria-haspopup="dialog">
        <FluentIcon Value="@s_historyIcon"
                    Class="@(SelectedRunIsCurrent ? null : "application-run-status")"
                    Color="@(SelectedRunIsCurrent ? Color.Default : Color.Warning)" />
        @if (ButtonText is { } text)
        {
            <span class="application-run-select-text">@text</span>
        }
    </FluentButton>
</div>
