@using Aspire.Dashboard.Resources
@inject IStringLocalizer<Layout> Loc
@inject IDashboardClient DashboardClient

@* Icon-only links keep the rail narrow. Each label is the link's accessible name and is shown in a tooltip, which
   unlike a native title attribute also appears on keyboard focus. *@
<nav class="main-rail" aria-label="@Loc[nameof(Layout.NavMenuLandmark)]">
    @{
        var displayedSection = GetDisplayedSection();
    }
    @foreach (var item in GetItems())
    {
        var isActive = item.Section == displayedSection;
        var id = $"main-rail-{item.Section.ToString().ToLowerInvariant()}";
        @if (item.DisabledText is { } disabledText && !isActive)
        {
            @* Kept in the rail so it doesn't move the entries below it when the page starts having content. It stays
               focusable so keyboard users can read why it's unavailable. *@
            <span id="@id"
                  class="main-rail-item disabled"
                  role="link"
                  tabindex="0"
                  aria-disabled="true"
                  aria-label="@item.Text"
                  aria-description="@disabledText">
                <FluentIcon Value="@item.Icon" Width="24px" Color="Color.Custom" CustomColor="currentColor" />
            </span>
            <FluentTooltip Anchor="@id" Positioning="Positioning.After">@disabledText</FluentTooltip>
        }
        else
        {
            <a id="@id"
               href="@item.Href"
               class="main-rail-item @(isActive ? "active" : null)"
               aria-label="@item.Text"
               aria-current="@(isActive ? "page" : null)">
                <FluentIcon Value="@(isActive ? item.ActiveIcon : item.Icon)" Width="24px" Color="Color.Custom" CustomColor="currentColor" />
            </a>
            <FluentTooltip Anchor="@id" Positioning="Positioning.After">@item.Text</FluentTooltip>
        }
    }
</nav>
