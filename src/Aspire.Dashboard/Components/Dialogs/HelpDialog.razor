@using Aspire.Dashboard.Resources

<FluentDialogBody Class="help-dialog-body">
    <div class="help-content">
        <p class="help-shortcuts-hint">@Loc[nameof(Dialogs.HelpDialogShortcutsHint)]</p>

        @{
            var shortcutCategories = GetShortcutsByCategory();
        }

        @* Description lists pair each action with its keys for assistive technology. *@
        <div class="help-shortcut-categories">
            @for (var categoryIndex = 0; categoryIndex < shortcutCategories.Count; categoryIndex++)
            {
                var shortcutCategory = shortcutCategories[categoryIndex];
                var categoryHeadingId = $"help-dialog-shortcut-category-{categoryIndex}";

                <section class="help-shortcut-category" aria-labelledby="@categoryHeadingId">
                    <h6 id="@categoryHeadingId">@shortcutCategory.Category</h6>
                    <dl aria-labelledby="@categoryHeadingId">
                        @foreach (var shortcut in shortcutCategory.Shortcuts)
                        {
                            <div class="help-shortcut">
                                <dt>@shortcut.Description</dt>
                                <dd>
                                    @for (var i = 0; i < shortcut.Keys.Length; i++)
                                    {
                                        <kbd>@shortcut.Keys[i]</kbd>

                                        if (i < shortcut.Keys.Length - 1)
                                        {
                                            <span aria-hidden="true">+</span>
                                        }
                                    }
                                </dd>
                            </div>
                        }
                    </dl>
                </section>
            }
        </div>
    </div>
</FluentDialogBody>
