{
  "resources": {
    "public-host": {
      "type": "parameter.v0",
      "value": "{public-host.inputs.value}",
      "inputs": {
        "value": {
          "type": "string"
        }
      }
    },
    "frontend": {
      "type": "container.v0",
      "image": "image:latest",
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "targetPort": 8080
        }
      }
    },
    "backend": {
      "type": "container.v0",
      "image": "image:latest",
      "env": {
        "REDIRECT": "{cond-frontend-bindings-http-tlsenabled-3c7f81b1.connectionString}",
        "NESTED": "{cond-frontend-bindings-http-tlsenabled-9550fa4c.connectionString}"
      }
    },
    "cond-frontend-bindings-http-tlsenabled-3c7f81b1": {
      "type": "value.v0",
      "connectionString": "{browser-frontend-preferred-origin-136c1e37de4e5761.connectionString}/signin-oidc"
    },
    "cond-frontend-bindings-http-tlsenabled-9550fa4c": {
      "type": "value.v0",
      "connectionString": "{cond-frontend-bindings-http-tlsenabled-3c7f81b1.connectionString}"
    },
    "browser-frontend-preferred-origin-136c1e37de4e5761": {
      "type": "value.v0",
      "connectionString": "https://{public-host.value}"
    }
  }
}