<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <!-- Linked Hosting DTOs retain their production inheritance shape. -->
    <NoWarn>$(NoWarn);CA1852</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Verify.XunitV3" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="StreamJsonRpc" />
    <PackageReference Include="ModelContextProtocol" />
    <Compile Include="../../src/Aspire.Hosting/Backchannel/BackchannelDataTypes.cs" Link="Shared/BackchannelDataTypes.cs" />
    <Compile Include="$(TestsSharedDir)Logging/*.cs" LinkBase="shared/Logging" />
    <ProjectReference Include="../../src/Aspire.Hosting.Native.Server/Aspire.Hosting.Native.Server.csproj" />
    <ProjectReference Include="../../src/Aspire.Hosting.Native.CodeGeneration/Aspire.Hosting.Native.CodeGeneration.csproj" />
    <ProjectReference Include="../../src/Aspire.Hosting.Native.Client/Aspire.Hosting.Native.Client.csproj" />
    <ProjectReference Include="../../playground/NativeIntegrations/CSharp/Contracts/NativeIntegrations.Contracts.csproj" />
    <ProjectReference Include="AotSmoke/Aspire.Hosting.Native.Core.AotSmoke.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../playground/NativeHosting/AtsServer/NativeHosting.AtsServer.csproj" Aliases="NativeLegacyServer" />
    <ProjectReference Include="../../playground/NativeHosting/Ats/NativeHosting.Ats.csproj" Aliases="NativeLegacy" />
    <ProjectReference Include="../../playground/NativeHosting/Core/NativeHosting.Core.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../playground/NativeHosting/AtsCodegen/NativeHosting.AtsCodegen.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../playground/NativeHosting/ManagedAdapter/NativeHosting.ManagedAdapter.csproj" ReferenceOutputAssembly="false" />
    <Compile Remove="AotSmoke/**/*.cs" />
    <None Update="AotSmoke/SymbolicRedisConsumer.mts" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
